[
  {
    "kernelSource": {
      "name": "sweet-official",
      "repo": "https://github.com/MiCode/Xiaomi_Kernel_OpenSource",
      "branch": "sweet-r-oss",
      "device": "sweet",
      "defconfig": "sweet_defconfig"
    },
    "withKernelSU": true,
    "withSUSFS": false,
    "toolchains": [
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9",
        "branch": "master",
        "name": "gcc64",
        "binPath": ["bin"]
      },
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9",
        "branch": "master",
        "name": "gcc32",
        "binPath": ["bin"]
      }
    ],
    "ccache": true,
    "params": {
      "ARCH": "arm64",
      "CC": "gcc64/bin/aarch64-linux-android-gcc",
      "externalCommand": {
        "CROSS_COMPILE": "gcc64/bin/aarch64-linux-android-",
        "CROSS_COMPILE_ARM32": "gcc32/bin/arm-linux-androideabi-"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/Kernel-SU/AnyKernel3",
      "branch": "master"
    }
  }
]
